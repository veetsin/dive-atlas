{
  "name": "dive-atlas",
  "private": true,
  "version": "0.1.0",
  "description": "Interactive bilingual (zh/en) illustrated world dive map — static site for GitHub Pages",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:dist": "node scripts/check-dist.mjs",
    "geo": "bash scripts/build-geo.sh",
    "preview:map": "node --experimental-strip-types scripts/preview-map.mts",
    "data:validate": "node scripts/validate-data.mjs",
    "data:pinyin": "node scripts/gen-pinyin.mjs",
    "sprites": "python3 scripts/process-sprites.py"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/d3-geo": "^3.1.0",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-zoom": "^3.0.8",
    "@types/geojson": "^7946.0.16",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "mapshaper": "^0.6.102",
    "pinyin-pro": "^3.26.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
